{
  "name": "simpaper",
  "productName": "Simpaper",
  "version": "0.1.0",
  "description": "Simpaper — open-source, Windows-first office suite (documents, spreadsheets, presentations, PDF) with a familiar ribbon UI, powered by the LibreOffice engine.",
  "license": "MPL-2.0",
  "author": "Simpaper contributors",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/run-electron-vite.mjs dev",
    "start": "node scripts/run-electron-vite.mjs preview",
    "build": "node scripts/run-electron-vite.mjs build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:engine": "vitest run --project engine",
    "test:all": "vitest run",
    "engine:fetch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/engine/fetch-engine.ps1",
    "engine:prepare": "node scripts/engine/prepare-engine.mjs",
    "corpus:generate": "node scripts/corpus/generate.mjs",
    "notices": "node scripts/generate-notices.mjs",
    "dist:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "dist:dir": "npm run build && electron-builder --win dir --config electron-builder.yml"
  },
  "dependencies": {
    "@cantoo/fontkit": "2.0.12",
    "@cantoo/pdf-lib": "2.11.1",
    "@tabler/icons-react": "3.48.0",
    "fast-xml-parser": "5.11.1",
    "html-entities": "2.6.0",
    "i18next": "26.4.2",
    "jszip": "3.10.2",
    "koffi": "3.3.2",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@napi-rs/canvas": "1.0.9",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "exceljs": "4.4.0",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "5.0.2"
  }
}
